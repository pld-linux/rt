# MySQL utf8 columns cannot store characters above U+FFFF (emoji): replace them with U+FFFD
# instead of losing the whole message, ticket or user, and index such messages too
diff -urN rt-4.4.9.orig/lib/RT/Handle.pm rt-4.4.9/lib/RT/Handle.pm
--- rt-4.4.9.orig/lib/RT/Handle.pm	2025-10-22 18:58:20.000000000 +0200
+++ rt-4.4.9/lib/RT/Handle.pm	2026-10-30 22:08:18.626666666 +0100
@@ -141,6 +141,24 @@
     $self->dbh->{'LongReadLen'} = RT->Config->Get('MaxAttachmentSize');
 }
 
+=head2 ReplaceUnstorableCharacters VALUE
+
+The MySQL connection and text columns use the 3-byte C<utf8> character
+set, which has no room for characters above U+FFFF, such as emoji; MySQL
+rejects the whole row that carries one.  Returns VALUE with each such
+character replaced by U+FFFD.  Other databases get VALUE unchanged.
+
+=cut
+
+sub ReplaceUnstorableCharacters {
+    my $self  = shift;
+    my $value = shift;
+
+    $value =~ s/[^\x{0}-\x{FFFF}]/\x{FFFD}/g
+        if defined $value and RT->Config->Get('DatabaseType') eq 'mysql';
+    return $value;
+}
+
 =head2 BuildDSN
 
 Build the DSN for the RT database. Doesn't take any parameters, draws all that
diff -urN rt-4.4.9.orig/lib/RT/Record.pm rt-4.4.9/lib/RT/Record.pm
--- rt-4.4.9.orig/lib/RT/Record.pm	2026-10-30 22:10:47.799414041 +0100
+++ rt-4.4.9/lib/RT/Record.pm	2026-10-30 22:08:21.179999999 +0100
@@ -632,6 +632,18 @@
 
 }
 
+# DBIx::SearchBuilder passes every column through TruncateValue in Create
+# and _Set; binary columns hold bytes and keep them as they are
+sub TruncateValue {
+    my $self  = shift;
+    my $key   = shift;
+    my $value = shift;
+
+    $value = $self->_Handle->ReplaceUnstorableCharacters($value)
+        unless ( $self->_Accessible( $key, 'type' ) // '' ) =~ /blob|binary/i;
+    return $self->SUPER::TruncateValue( $key, $value );
+}
+
 # Set up defaults for DBIx::SearchBuilder::Record::Cachable
 
 sub _CacheConfig {
