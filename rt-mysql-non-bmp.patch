diff -urN rt-4.4.9.orig/t/mail/non-bmp-characters.t rt-4.4.9/t/mail/non-bmp-characters.t
--- rt-4.4.9.orig/t/mail/non-bmp-characters.t	1970-01-01 01:00:00.000000000 +0100
+++ rt-4.4.9/t/mail/non-bmp-characters.t	1970-01-01 01:00:00.000000000 +0100
@@ -0,0 +1,96 @@
+use strict;
+use warnings;
+
+use RT::Test tests => undef;
+
+# MySQL text columns are 3-byte utf8, which cannot hold characters above
+# U+FFFF; RT stores U+FFFD in their place and keeps the rest of the message
+my $floppy = "\x{1F4BE}";
+my $stored = RT->Config->Get('DatabaseType') eq 'mysql' ? "\x{FFFD}" : $floppy;
+
+ok( RT::Test->set_rights(
+    { Principal => 'Everyone', Right => [qw(CreateTicket ReplyToTicket)] },
+), 'granted rights' );
+
+sub mail {
+    my %args = @_;
+    return MIME::Entity->build(
+        From    => Encode::encode( 'MIME-Header', "$floppy $args{Name}" ) . " <$args{Address}>",
+        To      => 'rt@example.com',
+        Subject => Encode::encode( 'MIME-Header', $args{Subject} ),
+        Type    => 'text/plain',
+        Charset => 'UTF-8',
+        Data    => [ Encode::encode( 'UTF-8', $args{Body} ) ],
+    )->stringify;
+}
+
+diag 'A new ticket from a new sender, with the character in the name, subject and body';
+{
+    my ( $status, $id ) = RT::Test->send_via_mailgate( mail(
+        Name    => 'Jan',
+        Address => 'jan@example.com',
+        Subject => "$floppy backup report",
+        Body    => "backup $floppy done\n",
+    ) );
+    is $status >> 8, 0, 'the mail gateway exited normally';
+
+    my $ticket = RT::Ticket->new( RT->SystemUser );
+    $ticket->Load($id);
+    ok $ticket->id, 'created a ticket';
+    is $ticket->Subject, "$stored backup report", 'ticket subject';
+
+    my $user = RT::User->new( RT->SystemUser );
+    $user->LoadByEmail('jan@example.com');
+    is $user->RealName, "$stored Jan", 'requestor name';
+
+    my $create = $ticket->Transactions->First;
+    ok $create && $create->Type eq 'Create', 'recorded the create transaction';
+    like $create && $create->Content, qr/backup $floppy done/, 'the body keeps the character';
+}
+
+diag 'A reply from a known sender with the character in the From header';
+{
+    my $user = RT::Test->load_or_create_user( EmailAddress => 'ola@example.com' );
+    my $ticket = RT::Test->create_ticket( Queue => 'General', Subject => 'storage report' );
+    my $tag = '[' . RT->Config->Get('rtname') . ' #' . $ticket->id . ']';
+
+    my ($status) = RT::Test->send_via_mailgate( mail(
+        Name    => 'Ola',
+        Address => 'ola@example.com',
+        Subject => "Re: $tag storage report",
+        Body    => "thanks $floppy\n",
+    ) );
+    is $status >> 8, 0, 'the mail gateway exited normally';
+
+    my $replies = $ticket->Transactions;
+    $replies->Limit( FIELD => 'Type', VALUE => 'Correspond' );
+    my $reply = $replies->First;
+    my $attachment = $reply && $reply->Attachments->First;
+    like $reply && $reply->Content, qr/thanks $floppy/, 'the reply keeps its body';
+    like $attachment && $attachment->Headers, qr/^From: "\Q$stored\E Ola"/m,
+        'the reply keeps its headers';
+
+    # the transaction itself stores the subject
+    ($status) = RT::Test->send_via_mailgate( mail(
+        Name    => 'Ola',
+        Address => 'ola@example.com',
+        Subject => "Re: $tag $floppy storage report",
+        Body    => "again $floppy\n",
+    ) );
+    is $status >> 8, 0, 'the mail gateway exited normally';
+    $replies->RedoSearch;
+    my $second = $replies->ItemsArrayRef->[1];
+    ok $second, 'recorded the reply with the character in its subject';
+    like $second && $second->Content, qr/again $floppy/, 'that reply keeps its body';
+
+    my $errors = $ticket->Transactions;
+    $errors->Limit( FIELD => 'Type', VALUE => 'AttachmentError' );
+    is $errors->Count, 0, 'no transaction lost its content';
+
+    my ( $ok, $msg ) = $ticket->SetSubject("$floppy renamed");
+    ok $ok, "set the subject: $msg";
+    $ticket->Load( $ticket->id );
+    is $ticket->Subject, "$stored renamed", 'new ticket subject';
+}
+
+done_testing;
