# TSV export: strip TAB/CR/LF from every cell before the formula escape (CVE-2026-41073 fix is incomplete without it)
From 1ae894b91c32c674810a4beb4aa62817f283836c Mon Sep 17 00:00:00 2001
From: PLD backport <claude.domena@gmail.com>
Date: Thu, 29 Oct 2026 21:43:03 +0100
Subject: [PATCH] Normalize TAB and line breaks in every TSV cell before the
 formula check

The CVE-2026-41073 fix prepends a space to header cells, but headers
skipped the TAB/CR/LF normalization the values get, so a column title
from a user-supplied search Format such as "x<TAB>=SUM(1)" still opens
a new cell starting with "=". Values had the same gap after
decode_entities: a subject "x&#9;=2+2" decodes to a TAB after the tabs
were already stripped.

Run one helper on the final text of every cell, headers included.

PLD hardening beyond upstream: RT 5.0.11 and 6.0.4 still carry this
incomplete fix for CVE-2026-41073.

CVE: CVE-2026-41073

diff --git a/share/html/Elements/TSVExport b/share/html/Elements/TSVExport
index 24e713e2d..a9a338a8b 100644
--- a/share/html/Elements/TSVExport
+++ b/share/html/Elements/TSVExport
@@ -106,9 +106,19 @@ else {
                           : () } @Format];
 }
 
-for (@columns) {
+# Applied to the final text of every cell: a TAB or line break would start a
+# new cell or row that the formula check below never looked at
+my $tsv_cell = sub {
+    my $val = shift;
+    $val = '' unless defined $val;
+    $val =~ s/(?:\n|\r)+/ /g; $val =~ s{\t}{    }g;
     # To prevent injection, add a leading space to make sure excel-ish applications treat it like a literal
-    $m->out(join("\t", map { s/^(?=-|\+|=|\@|")/ /; $_ } map { $_->{header} } @$_)."\n");
+    $val =~ s/^(?=-|\+|=|\@|")/ /;
+    return $val;
+};
+
+for (@columns) {
+    $m->out(join("\t", map { $tsv_cell->($_->{header}) } @$_)."\n");
 }
 
 my $i = 0;
@@ -123,9 +133,7 @@ while (my $row = $Collection->Next) {
             $val =~ s/(?:\n|\r)+/ /g; $val =~ s{\t}{    }g;
             $val = $no_html->scrub($val);
             $val = HTML::Entities::decode_entities($val);
-            # To prevent injection, add a leading space to make sure excel-ish applications treat it like a literal
-            $val =~ s/^(?=-|\+|=|\@|")/ /;
-            $val;
+            $tsv_cell->($val);
         } @$col)."\n");
     }
     $m->flush_buffer unless ++$i % 10;
